  rdfs:comment """Water consumption of the product.

This class description needs to be extended/specialised according to the corresponding delegated acts or/and industry standards."""@en ;
  rdfs:label "Water consumption"@en .

<https://w3id.org/eudpp#Weight>
  a owl:Class ;
